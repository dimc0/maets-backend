# Modèle de configuration : copier ce fichier en .env puis adapter les valeurs.
# Ce fichier est versionné, il ne doit contenir AUCUN vrai secret.

# Port de l'API (HTTPS)
PORT=3000

# PostgreSQL (base relationnelle : utilisateurs, jeux, librairies)
# Avec Docker (docker compose up -d) : DB_PORT=5433 ; PostgreSQL installé sur le poste : 5432
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=maets
DB_USER=maets
DB_PASS=change-me

# MongoDB (base NoSQL : configurations des jeux)
# Avec Docker : mongodb://127.0.0.1:27018/maets ; MongoDB installé sur le poste : port 27017
MONGODB_URI=mongodb://127.0.0.1:27017/maets

# Comptes créés par les seeders (npm run db:seed)
# Compte administrateur (sert aussi en production, avec un vrai mot de passe)
ADMIN_EMAIL=admin@maets.local
ADMIN_PASSWORD=change-me
# Mot de passe commun aux joueurs de démo (développement uniquement)
SEED_USER_PASSWORD=change-me


# Authentification JWT : JWT_SECRET doit être une longue chaîne aléatoire, par exemple :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Test de charge : dossier où JMeter a été dézippé (npm run load-test)
JMETER_HOME=C:\outils\apache-jmeter-5.6.3
